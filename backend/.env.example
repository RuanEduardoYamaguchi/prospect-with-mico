# Copie este arquivo para ".env" (sem o .example) e preencha o que for usar.
# O "configurar.bat" na raiz do projeto já faz essa cópia pra você.
#
# NADA aqui vem preenchido: as chaves são suas, a ferramenta não traz nenhuma.
# Você também pode colar as chaves pela tela Configurações do sistema (ficam no
# cofre de credenciais do Windows, nunca em texto puro) e não mexer neste
# arquivo. Se configurar dos dois jeitos, o que está salvo na tela vale mais.
#
# O arquivo ".env" NUNCA deve ir pro Git (o .gitignore já cuida disso).

# ---------------------------------------------------------------------------
# Busca de negócios (obrigatória pra achar leads)
# ---------------------------------------------------------------------------

# Google Places API: Google Cloud Console > APIs e serviços > Credenciais
# https://console.cloud.google.com/apis/credentials
# (ative a "Places API (New)" no projeto). Tem cota gratuita mensal, e a
# ferramenta respeita um teto de consultas pra você não passar dela.
PLACES_API_KEY=

# ---------------------------------------------------------------------------
# IA que escreve as mensagens (configure pelo menos UMA)
# Com várias, a ferramenta tenta uma e passa pra próxima se a cota acabar.
# ---------------------------------------------------------------------------

# Claude (Anthropic): https://console.anthropic.com/settings/keys  (pago, por uso)
ANTHROPIC_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey  (tem plano gratuito)
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys  (tem plano gratuito)
GROQ_API_KEY=

# NVIDIA Build: https://build.nvidia.com  (tem plano gratuito)
NVIDIA_API_KEY=

# Opcional: nota oficial de desempenho do Google no diagnóstico em PDF.
# https://developers.google.com/speed/docs/insights/v5/get-started
# PAGESPEED_API_KEY=

# ---------------------------------------------------------------------------
# WhatsApp (opcional: sem isso você prospecta e copia a mensagem à mão)
# ---------------------------------------------------------------------------

# Onde a Evolution API (WhatsApp) responde e o nome da conexão. Os padrões
# servem pra quem subiu tudo com o iniciar.bat.
# EVOLUTION_URL=http://localhost:8080
# EVOLUTION_INSTANCIA=prospector

# O número principal do seu negócio (DDD + número, com ou sem o 55). Campanha
# em massa NUNCA roda nele: se o número cair por denúncia, cai junto o canal com
# seus clientes. Preencha, e a ferramenta recusa campanha se esse número for o
# chip conectado. Sem isso a trava fica desligada.
# NUMERO_OFICIAL=41999990000

# Só se você ainda não tem um chip separado: libera campanha no número oficial
# com teto de 20 envios por dia. Apague a linha quando tiver o chip de prospecção.
# PERMITIR_CAMPANHA_NO_OFICIAL=true

# Número (DDD + número, sem o 55) que recebe um aviso no WhatsApp quando um lead
# esquenta na conversa automática. Sem isso, nenhum aviso é enviado.
# NUMERO_NOTIFICACAO_QUALIFICACAO=41999990000

# ---------------------------------------------------------------------------
# Avançado (pode ignorar)
# ---------------------------------------------------------------------------

# "true" só se estiver depurando a ferramenta.
PROSPECCAO_DEBUG=false

# Nível de detalhe do logs/prospeccao.log (DEBUG, INFO, WARNING, ERROR).
# PROSPECCAO_LOG_LEVEL=INFO

# Só se usar o scraper antigo do Maps: caminho do node.exe, caso o seu Node NÃO
# esteja no local padrão (C:\Program Files\nodejs).
# PLAYWRIGHT_NODEJS_PATH=C:\caminho\para\node.exe
