# Evolution API: configuração local.
#
# NÃO copie este arquivo na mão. Rode o "configurar.bat" na raiz do projeto: ele
# cria o ".env" de verdade trocando os dois __GERAR_...__ abaixo por valores
# aleatórios gerados na sua máquina. O ".env" nunca vai pro Git.

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

# Chave mestra da API. Tudo que o PROSPECT WITH MICO envia usa ela no header "apikey".
AUTHENTICATION_API_KEY=__GERAR_CHAVE_DA_API__

# Senha do Postgres (o docker-compose lê esta mesma variável)
POSTGRES_PASSWORD=__GERAR_SENHA_DO_BANCO__

# Banco (Postgres do docker-compose)
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:__GERAR_SENHA_DO_BANCO__@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=prospector

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Cache
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=prospector
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Comportamento da instância
CONFIG_SESSION_PHONE_CLIENT=PROSPECT WITH MICO
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
DEL_INSTANCE=false
LANGUAGE=pt-BR

# Webhook global: manda mensagem recebida e status de conexão pro backend do
# PROSPECT WITH MICO (porta 5000), que marca o lead como "respondeu".
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://host.docker.internal:5000/api/whatsapp/webhook
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true

LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error
